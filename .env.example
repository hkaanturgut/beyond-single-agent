# Runtime backend selection
# Options: github_models | foundry
TRIP_BACKEND=github_models

# Shared model controls
TRIP_MODEL_NAME=gpt-5-mini

# Azure AI Foundry settings (used when TRIP_BACKEND=foundry)
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_MODEL_NAME=gpt-5-mini

# Optional service principal values for DefaultAzureCredential (Foundry mode)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-a-secret-from-your-secret-store

# GitHub Models settings (used when TRIP_BACKEND=github_models)
GITHUB_TOKEN=replace-with-github-token
GITHUB_MODEL_NAME=gpt-4o-mini

# Optional MCP settings (stretch goal, not required for core flow)
MCP_TAVILY_URL=https://your-mcp-tavily.example.com
MCP_FILESYSTEM_URL=https://your-mcp-filesystem.example.com
MCP_API_KEY=replace-with-a-tool-api-key
