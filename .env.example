# =============================================================================
# Beyond a Single Agent — Trip Planner Demo
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend selection
# demo          — no external calls; deterministic placeholder responses
# github_models — live LLM via GitHub Models (free tier, needs GITHUB_TOKEN)
# foundry       — 5 hosted PromptAgents in Azure AI Foundry (production)
# ---------------------------------------------------------------------------
TRIP_BACKEND=demo

# ---------------------------------------------------------------------------
# GitHub Models (TRIP_BACKEND=github_models)
# Get a free token: https://github.com/settings/tokens (no scopes needed)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=ghp_replace_with_your_github_token
GITHUB_MODEL_NAME=gpt-4o-mini

# ---------------------------------------------------------------------------
# Azure AI Foundry (TRIP_BACKEND=foundry)
# Run scripts/deploy_agents.py once after infra deploy to register agents.
# ---------------------------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=https://aitripmvkshspr7axak.services.ai.azure.com/api/projects/trip-planner-prod
FOUNDRY_MODEL_NAME=gpt-5-mini

# Azure credentials — used by DefaultAzureCredential in CI/CD.
# For local dev, run `az login` instead of setting these.
AZURE_TENANT_ID=ffe3d4fb-2c1a-4bee-be2f-4b6e78f182c9
AZURE_SUBSCRIPTION_ID=fc4b39c5-adad-4de0-a91a-06dd08aa2e8f
# AZURE_CLIENT_ID and AZURE_CLIENT_SECRET are only needed for service principal auth.
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=replace-with-secret
