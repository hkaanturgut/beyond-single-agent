# =============================================================================
# Beyond a Single Agent — Trip Planner Demo (Azure AI Foundry only)
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend selection (both use the SAME Azure AI Foundry project)
# foundry         — hosted multi-agent workflow: 5 PromptAgents in Foundry
#                   Agent Service, invoked via the Responses API  [default]
# foundry_models  — direct chat completions on the same Foundry model
#                   deployment (no hosted agents required)
# ---------------------------------------------------------------------------
TRIP_BACKEND=foundry

# ---------------------------------------------------------------------------
# Azure AI Foundry (required)
# These are populated automatically from your Bicep deployment outputs — see
# "Step 3: Capture deployment outputs into .env" in the README. Do NOT hardcode
# a specific resource: the endpoint is unique to the account you provision, and
# resource names change every time you deploy from scratch.
# Then run scripts/deploy_agents.py once to register the agents (for foundry).
# ---------------------------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=https://<your-ai-services-account>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL_NAME=gpt-5-mini

# Azure credentials — used by DefaultAzureCredential in CI/CD.
# For local dev, run `az login` instead of setting these.
# AZURE_TENANT_ID=<your-tenant-id>
# AZURE_SUBSCRIPTION_ID=<your-subscription-id>
# AZURE_CLIENT_ID and AZURE_CLIENT_SECRET are only needed for service principal auth.
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=replace-with-secret

# ---------------------------------------------------------------------------
# Agent tools
# The specialist agents are deployed with Foundry-hosted tools (web_search,
# code_interpreter) — these need NO extra configuration and work on
# pay-as-you-go (no billable "Grounding with Bing Search" resource required).
#
# Optional: attach a remote MCP server to the researcher agent for extra
# capabilities (e.g. a maps/places or private data lookup server). Leave
# MCP_SERVER_URL unset to use hosted web search only (the default).
# ---------------------------------------------------------------------------
# MCP_SERVER_URL=https://your-mcp-server.example.com/sse
# MCP_SERVER_LABEL=trip_tools
# MCP_ALLOWED_TOOLS=search,lookup     # optional comma-separated allow-list
