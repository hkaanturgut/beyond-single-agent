# Azure AI Foundry project settings
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_MODEL_NAME=gpt-4.1-mini

# Optional service principal values for DefaultAzureCredential
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-a-secret-from-your-secret-store

# Optional MCP gateway placeholders
MCP_TOOL_ENDPOINT=https://your-mcp-gateway.example.com
MCP_TOOL_API_KEY=replace-with-a-tool-api-key

# Demo switches
ENABLE_LIVE_FOUNDRY=0

